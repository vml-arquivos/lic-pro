# Ambiente
NODE_ENV=development
APP_ENV=development
LOG_LEVEL=info

# URLs públicas — podem ser domínios separados ou um mesmo domínio com paths
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
WS_URL=ws://localhost:3003
ALLOWED_ORIGINS=http://localhost:3000

# PostgreSQL + pgvector
POSTGRES_DB=licite_comigo
POSTGRES_OWNER_USER=licite_owner
POSTGRES_OWNER_PASSWORD=change-me-local-only
MIGRATION_DATABASE_URL=postgresql://licite_owner:change-me-local-only@localhost:5432/licite_comigo
CORE_DB_PASSWORD=change-me-core-local-only
INGEST_DB_PASSWORD=change-me-ingest-local-only
AI_DB_PASSWORD=change-me-ai-local-only
BID_DB_PASSWORD=change-me-bid-local-only
REALTIME_DB_PASSWORD=change-me-realtime-local-only
CORE_DATABASE_URL=postgresql://licite_core:change-me-core-local-only@localhost:5432/licite_comigo
INGEST_DATABASE_URL=postgresql://licite_ingest:change-me-ingest-local-only@localhost:5432/licite_comigo
AI_DATABASE_URL=postgresql://licite_ai:change-me-ai-local-only@localhost:5432/licite_comigo
BID_DATABASE_URL=postgresql://licite_bid:change-me-bid-local-only@localhost:5432/licite_comigo
REALTIME_DATABASE_URL=postgresql://licite_realtime:change-me-realtime-local-only@localhost:5432/licite_comigo

# Redis
REDIS_PASSWORD=change-me-redis-local-only
REDIS_URL=redis://localhost:6379/0

# RabbitMQ
RABBITMQ_URL=amqp://licite:change-me-local-only@localhost:5672/licite_comigo
RABBITMQ_USER=licite
RABBITMQ_PASSWORD=change-me-local-only

# Fontes públicas do Radar — URLs oficiais documentadas
PNCP_BASE_URL=https://pncp.gov.br/api/consulta
COMPRAS_GOV_BASE_URL=https://dadosabertos.compras.gov.br
INGEST_RATE_LIMIT_SECONDS=0.2
INGEST_MAX_RETRIES=3
INGEST_PAGE_SIZE=50
INGEST_HTTP_TIMEOUT_SECONDS=30
INGEST_SCHEDULE_SECONDS=900
INGEST_SCHEDULE_TENANT_ID=
INGEST_SCHEDULE_MODALITY_CODE=6
INGEST_SCHEDULE_UF=
INGEST_WINDOW_DAYS=1
RUN_INGEST_SMOKE=0
PNCP_SMOKE_MODALITY_CODE=6
PNCP_SMOKE_START_DATE=
PNCP_SMOKE_END_DATE=
PNCP_SMOKE_UF=

# Segurança da aplicação (substitua em cada ambiente)
JWT_SECRET=replace-with-a-long-random-secret

# IA: providers são selecionáveis por configuração, nunca hardcoded
LLM_PROVIDER=fake
LLM_MODEL=local-development
LLM_API_KEY=
LLM_API_BASE_URL=
EMBEDDING_PROVIDER=deterministic
EMBEDDING_MODEL=local-development
EMBEDDING_API_KEY=
EMBEDDING_API_BASE_URL=
AI_INTERNAL_URL=http://ai:8000
AI_JWT_ALGORITHM=HS256
AI_JWT_SECRET=replace-with-a-long-random-ai-jwt-secret
AI_JWT_PUBLIC_KEY=
AI_JWT_ISSUER=licite-comigo
AI_JWT_AUDIENCE=licite-comigo-ai
AI_MAX_PDF_BYTES=20971520
AI_MAX_PDF_PAGES=200
AI_READER_TIMEOUT_SECONDS=30
AI_RATE_LIMIT_PER_MINUTE_USER=20
AI_RATE_LIMIT_PER_MINUTE_TENANT=100
AI_DEFAULT_MONTHLY_CALL_LIMIT=1000
AI_DEFAULT_MONTHLY_TOKEN_LIMIT=1000000
ANA_HISTORY_RETENTION_DAYS=365

# Serviços
CORE_API_PORT=3001
AI_PORT=8000
INGEST_PORT=8100
BID_ENGINE_PORT=3002
REALTIME_PORT=3003
WEB_PORT=3000

# Flags de desenvolvimento
ENABLE_OCR=false
ENABLE_DEV_SEED=false
