# Ambiente
NODE_ENV=development
APP_ENV=development
LOG_LEVEL=info

# URLs públicas — podem ser domínios separados ou um mesmo domínio com paths
APP_URL=http://localhost:3000
SITE_URL=http://localhost:3100
PORT=3000
API_URL=http://localhost:3001
CORE_API_INTERNAL_URL=http://localhost:3001
WS_URL=ws://localhost:3003
ALLOWED_ORIGINS=http://localhost:3000
WHATSAPP_NUMBER=
BRAND_SLOGAN=Clareza para decidir o próximo passo

# PostgreSQL + pgvector
POSTGRES_DB=licite_comigo
POSTGRES_ADMIN_USER=licite_admin
POSTGRES_ADMIN_PASSWORD=change-me-local-only
MIGRATION_DATABASE_URL=postgresql://licite_admin:change-me-local-only@localhost:5432/licite_comigo
CORE_DB_PASSWORD=change-me-core-local-only
INGEST_DB_PASSWORD=change-me-ingest-local-only
AI_DB_PASSWORD=change-me-ai-local-only
BID_DB_PASSWORD=change-me-bid-local-only
REALTIME_DB_PASSWORD=change-me-realtime-local-only
CORE_DATABASE_URL=postgresql://licite_core:change-me-core-local-only@localhost:5432/licite_comigo
DATABASE_URL=postgresql://licite_core:change-me-core-local-only@localhost:5432/licite_comigo
INGEST_DATABASE_URL=postgresql://licite_ingest:change-me-ingest-local-only@localhost:5432/licite_comigo
AI_DATABASE_URL=postgresql://licite_ai:change-me-ai-local-only@localhost:5432/licite_comigo
BID_DATABASE_URL=postgresql://licite_bid:change-me-bid-local-only@localhost:5432/licite_comigo
REALTIME_DATABASE_URL=postgresql://licite_realtime:change-me-realtime-local-only@localhost:5432/licite_comigo

# Redis
REDIS_PASSWORD=change-me-redis-local-only
REDIS_URL=redis://localhost:6379/0

# RabbitMQ
RABBITMQ_VHOST=licite_comigo
RABBITMQ_URL=amqp://licite:change-me-local-only@localhost:5672/licite_comigo
RABBITMQ_USER=licite
RABBITMQ_PASSWORD=change-me-local-only

# Fontes públicas do Radar — URLs oficiais documentadas
PNCP_BASE_URL=https://pncp.gov.br/api/consulta
COMPRAS_GOV_BASE_URL=https://dadosabertos.compras.gov.br
INGEST_RATE_LIMIT_SECONDS=0.2
INGEST_MAX_RETRIES=3
INGEST_PAGE_SIZE=50
INGEST_HTTP_TIMEOUT_SECONDS=30
INGEST_SCHEDULE_SECONDS=900
INGEST_SCHEDULE_TENANT_ID=
INGEST_SCHEDULE_MODALITY_CODE=6
INGEST_SCHEDULE_UF=
INGEST_WINDOW_DAYS=1
RUN_INGEST_SMOKE=0
PNCP_SMOKE_MODALITY_CODE=6
PNCP_SMOKE_START_DATE=
PNCP_SMOKE_END_DATE=
PNCP_SMOKE_UF=

# Segurança da aplicação (substitua em cada ambiente)
JWT_SECRET=replace-with-a-long-random-secret
JWT_TTL_SECONDS=3600
JWT_ISSUER=licite-comigo
JWT_AUDIENCE=licite-comigo-ai

# Contas, consentimento e e-mail
SIGNUP_ENABLED=false
TERMS_VERSION=2026-10-17-draft
PRIVACY_VERSION=2026-10-17-draft
EMAIL_PROVIDER=fake
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
BOOTSTRAP_TENANT_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# true cria a conta da equipe do produto (papel plataforma) em vez de uma conta de empresa.
BOOTSTRAP_PLATFORM=
# Para promover um administrador que já existe (pnpm admin:promote-platform):
PLATFORM_ADMIN_EMAIL=
PLATFORM_TENANT_ID=
# Redefinir a senha de uma conta pelo servidor (pnpm admin:reset-password):
RESET_EMAIL=
RESET_PASSWORD=
RESET_TENANT_ID=

# Alertas: o motor roda dentro do core-api. Use false para desligar; o intervalo é em segundos (mínimo 60).
ALERT_ENGINE_ENABLED=true
ALERT_ENGINE_INTERVAL_SECONDS=300

# Coleta de editais do governo (PNCP) — roda dentro do core-api, sem fila nem serviço extra.
# Desligue com PNCP_SYNC_ENABLED=false. Intervalo em minutos (5-1440), janela em dias (1-30),
# modalidades pelos códigos do PNCP (6 pregão eletrônico, 8 dispensa, 4 concorrência).
PNCP_SYNC_ENABLED=true
PNCP_SYNC_INTERVAL_MINUTES=30
PNCP_SYNC_DAYS=2
PNCP_SYNC_MODALIDADES=6,8,4
PNCP_SYNC_MAX_PAGES=40
# Opcional: id da empresa-catálogo que recebe os editais (padrão: a primeira conta da equipe).
PNCP_SYNC_TENANT_ID=

# Foto opcional da mentora na rede de especialistas (caminho começando com / ou https://).
MENTORA_FOTO_URL=

# IA: providers são selecionáveis por configuração, nunca hardcoded
# Produção Gemini: LLM_PROVIDER=gemini, EMBEDDING_PROVIDER=gemini,
# LLM_MODEL=gemini-3.1-pro-preview, EMBEDDING_MODEL=gemini-embedding-001.
LLM_PROVIDER=fake
LLM_MODEL=local-development
LLM_API_KEY=
LLM_API_BASE_URL=
LLM_TIMEOUT_SECONDS=60
EMBEDDING_PROVIDER=deterministic
EMBEDDING_MODEL=local-development
EMBEDDING_API_KEY=
EMBEDDING_API_BASE_URL=
GEMINI_API_KEY=
AI_INTERNAL_URL=http://ai:8000
AI_JWT_ALGORITHM=HS256
AI_JWT_SECRET=replace-with-the-same-secret-as-JWT_SECRET
AI_JWT_PUBLIC_KEY=
AI_JWT_ISSUER=licite-comigo
AI_JWT_AUDIENCE=licite-comigo-ai
AI_MAX_PDF_BYTES=20971520
AI_MAX_PDF_PAGES=200
AI_READER_TIMEOUT_SECONDS=30
AI_RATE_LIMIT_PER_MINUTE_USER=20
AI_RATE_LIMIT_PER_MINUTE_TENANT=100
AI_DEFAULT_MONTHLY_CALL_LIMIT=1000
AI_DEFAULT_MONTHLY_TOKEN_LIMIT=1000000
ANA_HISTORY_RETENTION_DAYS=365

# Serviços
CORE_API_PORT=3001
AI_PORT=8000
INGEST_PORT=8100
BID_ENGINE_PORT=3002
REALTIME_PORT=3003
WEB_PORT=3000
SITE_PORT=3100
BID_ENGINE_PORT=3002
REALTIME_PORT=3003
MIGRATE_IDLE_AFTER=false

# Flags de desenvolvimento
ENABLE_OCR=false
DEMO_MODE=false
