# Ambiente
NODE_ENV=development
APP_ENV=development
LOG_LEVEL=info

# PostgreSQL + pgvector
POSTGRES_DB=licite_comigo
POSTGRES_USER=licite
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql://licite:change-me-local-only@localhost:5432/licite_comigo

# Redis
REDIS_URL=redis://localhost:6379/0

# RabbitMQ
RABBITMQ_URL=amqp://licite:change-me-local-only@localhost:5672/licite_comigo
RABBITMQ_USER=licite
RABBITMQ_PASSWORD=change-me-local-only

# Segurança da aplicação (substitua em cada ambiente)
JWT_SECRET=replace-with-a-long-random-secret

# IA: providers são selecionáveis por configuração, nunca hardcoded
LLM_PROVIDER=fake
LLM_MODEL=local-development
OPENAI_API_KEY=
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=local-development

# Serviços
CORE_API_PORT=3001
AI_PORT=8000
BID_ENGINE_PORT=3002
REALTIME_PORT=3003
WEB_PORT=3000

# Flags de desenvolvimento
ENABLE_OCR=false
ENABLE_DEV_SEED=false
