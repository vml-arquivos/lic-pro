{
  "name": "licite-comigo",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma de inteligência e formação para licitações públicas brasileiras.",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "db:migrate": "sh db/migrate.sh",
    "db:seed": "sh db/seed.sh",
    "dev": "pnpm --parallel --if-present dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ingest:smoke": "python3 services/ingest/scripts/smoke.py",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.5",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.1",
    "vitest": "^2.1.8"
  }
}
